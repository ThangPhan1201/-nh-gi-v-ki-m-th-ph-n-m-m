{
  "name": "webtest-cli",
  "version": "2.0.0",
  "description": "CLI-based automated web testing tool with smart crawling",
  "main": "dist/index.js",
  "bin": {
    "webtest": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:api": "vitest run src/tests/unit/APITester.test.ts",
    "test:unit": "vitest run src/tests/unit/"
  },
  "keywords": [
    "cli",
    "testing",
    "playwright",
    "automation",
    "web-testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^11.1.0",
    "pg": "^8.21.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "@vitest/ui": "^4.1.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  },
  "vitest": {
    "include": [
      "src/tests/**/*.test.ts"
    ],
    "environment": "node",
    "globals": true
  }
}
